diff --git a/tools/fastboot_guard.sh b/tools/fastboot_guard.sh
index 6fad0ac..9d5e598 100755
--- a/tools/fastboot_guard.sh
+++ b/tools/fastboot_guard.sh
@@ -90,7 +90,7 @@ case "$cmd" in
     [ "$1" = "boot_b" ] || refuse "flash só em boot_b (pedido: '$1')"
     file="$2"
     [ -f "$file" ] || refuse "arquivo inexistente ou não-regular: '$file'"
-    GDIR="$(mktemp -d "${TMPDIR:-/tmp}/fastboot_guard.XXXXXX")" || refuse "mktemp falhou"
+    GDIR="$(mkdir -p "${TMPDIR:-$HOME/.cache/fastboot_guard}" && mktemp -d "${TMPDIR:-$HOME/.cache/fastboot_guard}/fastboot_guard.XXXXXX")" || refuse "mktemp falhou"
     IMG="$GDIR/image.bin"
     cp -- "$file" "$IMG" 2>/dev/null || refuse "não consegui copiar '$file'"
     chmod 0400 "$IMG" || refuse "chmod 0400 falhou"
@@ -111,7 +111,7 @@ case "$cmd" in
     [ $# -eq 1 ] || refuse "rollback precisa de exatamente: rollback <arquivo>"
     file="$1"
     [ -f "$file" ] || refuse "arquivo inexistente ou não-regular: '$file'"
-    GDIR="$(mktemp -d "${TMPDIR:-/tmp}/fastboot_guard.XXXXXX")" || refuse "mktemp falhou"
+    GDIR="$(mkdir -p "${TMPDIR:-$HOME/.cache/fastboot_guard}" && mktemp -d "${TMPDIR:-$HOME/.cache/fastboot_guard}/fastboot_guard.XXXXXX")" || refuse "mktemp falhou"
     IMG="$GDIR/image.bin"
     cp -- "$file" "$IMG" 2>/dev/null || refuse "não consegui copiar '$file'"
     chmod 0400 "$IMG" || refuse "chmod 0400 falhou"
diff --git a/tools/selftest_fastboot_guard.sh b/tools/selftest_fastboot_guard.sh
index a1e0375..459d82b 100755
--- a/tools/selftest_fastboot_guard.sh
+++ b/tools/selftest_fastboot_guard.sh
@@ -32,7 +32,9 @@ if [ "\$1" = "getvar" ] && [ "\$2" = "partition-size:boot_b" ]; then
   printf '%s\n' "\${FAKE_PART_LINE:-partition-size:boot_b: 4000000}" >&2
 fi
 if [ "\$1" = "getvar" ] && [ "\$2" = "slot-unbootable:b" ]; then
-  printf '%s\n' "\${FAKE_UNBOOT_LINE:-slot-unbootable:b: no}" >&2
+  unboot_line="\${FAKE_UNBOOT_LINE:-slot-unbootable:b: no}"
+  printf 'FAKE-STATE %s\n' "\$unboot_line" >> "$STUBLOG"
+  printf '%s\n' "\$unboot_line" >&2
 fi
 echo "FAKE-OKAY \$*"
 exit 0
@@ -430,11 +432,17 @@ FAKE_SLOT_LINE='current-slot: b' FAKE_USER_LINE='is-userspace: no' FAKE_UNBOOT_L
   "$GUARD" rollback "$GOODIMG" >/dev/null 2>&1
 r1_rc=$?
 r1_log="$(tail -n +$((r1_before + 1)) "$STUBLOG" 2>/dev/null || true)"
+# Ordem: o flash do backup precisa vir antes do set_active b. Presença sozinha não prova a ordem.
+r1_flash_line="$(grep -n '^flash boot_b ' <<<"$r1_log" | head -n 1 | cut -d: -f1)"
+r1_set_line="$(grep -n -x 'set_active b' <<<"$r1_log" | head -n 1 | cut -d: -f1)"
 if [ "$r1_rc" -eq 0 ] \
     && grep -q '^flash boot_b ' <<<"$r1_log" \
+    && grep -qx 'getvar slot-unbootable:b' <<<"$r1_log" \
+    && grep -qx 'FAKE-STATE slot-unbootable:b: yes' <<<"$r1_log" \
     && grep -qx 'set_active b' <<<"$r1_log" \
-    && ! grep -q 'set_active a' <<<"$r1_log"; then
-  printf '    flash boot_b + set_active b; set_active a ausente\n  => OK\n\n'
+    && [ -n "$r1_flash_line" ] && [ -n "$r1_set_line" ] && [ "$r1_flash_line" -lt "$r1_set_line" ] \
+    && ! grep -qx 'set_active a' <<<"$r1_log"; then
+  printf '    fastboot stub + estado:\n%s\n    flash antes de set_active b; set_active a ausente\n  => OK\n\n' "$r1_log"
   pass=$((pass + 1))
 else
   printf '    ESPERAVA flash boot_b e set_active b sem set_active a; rc=%s\n%s\n  => FALHA\n\n' "$r1_rc" "$r1_log"
